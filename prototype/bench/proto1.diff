+@wp.func
+def _origin_on_face(status: int) -> bool:
+  # polytope3 statuses 6-11: the origin is within MIN_DIST3 of hexahedron face (status - 6)
+  return status >= 6 and status <= 11
+
+
+@wp.func
+def _face_extent(
+  pt: Polytope, face_idx: int, geom1: Geom, geom2: Geom, geomtype1: int, geomtype2: int
+) -> Tuple[float, float]:
+  """Returns the depth of the origin below a polytope face and the Minkowski extent beyond it."""
+  face = _get_face_verts(pt.face[face_idx])
+  v1 = pt.vert[2 * face[0]] - pt.vert[2 * face[0] + 1]
+  v2 = pt.vert[2 * face[1]] - pt.vert[2 * face[1] + 1]
+  v3 = pt.vert[2 * face[2]] - pt.vert[2 * face[2] + 1]
+
+  n = wp.cross(v2 - v1, v3 - v1)
+  norm = wp.norm_l2(n)
+  if norm < MINVAL:
+    return 0.0, FLOAT_MAX
+  n = wp.where(wp.dot(n, v1 - pt.center) < 0.0, -n, n) / norm
+
+  # vertex 5 is free in a hexahedron
+  _epa_support(pt, 5, geom1, geom2, geomtype1, geomtype2, n)
+  w = pt.vert[10] - pt.vert[11]
+  return wp.dot(n, v1), wp.dot(n, w - v1)
+
